{
  "name": "flutter",
  "source_dirs": [
    "lib/"
  ],
  "test_dirs": [
    "test/",
    "integration_test/"
  ],
  "commands": {
    "test": "{flutter} test {target}",
    "test_all": "{flutter} test",
    "format": "{dart} format lib test",
    "analyze": "{flutter} analyze",
    "codegen": "{dart} run build_runner build --delete-conflicting-outputs"
  },
  "risk_areas": [
    "android/**",
    "ios/**",
    "macos/**",
    "web/**",
    "pubspec.yaml"
  ],
  "secret_files": [
    "(^|/)key\\.properties$",
    "(^|/)local\\.properties$",
    "(^|/)env/(?![^/]*\\.example\\.json$)[^/]+\\.json$",
    "(^|/)\\.?dart_defines?(\\.[\\w-]+)?\\.json$",
    "(^|/)service-account[^/]*\\.json$"
  ],
  "secret_value_allow": [
    "(^|/)google-services\\.json$",
    "(^|/)GoogleService-Info\\.plist$",
    "(^|/)firebase_options\\.dart$"
  ],
  "protected": {
    "bash_ask": [
      [
        "\\b(flutter|dart)\\s+pub\\s+(add|remove|upgrade|outdated\\s+--apply)\\b",
        "패키지 추가 · 삭제 · 업그레이드는 사용자 확인 필요"
      ],
      [
        "\\bflutterfire\\s+configure\\b",
        "Firebase 프로젝트 연결은 사용자 확인 필요"
      ],
      [
        "\\bflutter\\s+build\\b[^;&|]*--release\\b",
        "릴리스 빌드는 CI 가 한다 — 로컬 실행은 사용자 확인 필요"
      ]
    ],
    "bash_deny": [
      [
        "\\bfirebase\\s+deploy\\b",
        "배포는 사용자가 한다"
      ],
      [
        "\\bkeytool\\b[^;&|]*-genkey",
        "서명 키 생성은 사용자가 한다"
      ]
    ],
    "file_deny": [
      [
        "(^|/)key\\.properties$",
        "Android 서명 설정은 고치지 않는다"
      ],
      [
        "(^|/)env/[^/]+\\.json$",
        "환경별 비밀 값(dart-define 파일)은 고치지 않는다 — env/*.example.json 만"
      ],
      [
        "(^|/)service-account[^/]*\\.json$",
        "서비스 계정 키는 다루지 않는다"
      ]
    ],
    "file_allow": [
      "(^|/)env/[^/]+\\.example\\.json$"
    ],
    "file_ask": [
      [
        "\\.(g|freezed|gr|config|mocks|chopper)\\.dart$",
        "생성 파일이다 — 직접 고치지 말고 build_runner 로 다시 만든다"
      ],
      [
        "(^|/)pubspec\\.yaml$",
        "의존성 · 앱 설정 변경은 사용자 확인 필요"
      ],
      [
        "(^|/)analysis_options\\.yaml$",
        "린트 설정 변경은 사용자 확인 필요 (하네스 우회 방지)"
      ],
      [
        "(^|/)(android|ios|macos)/",
        "플랫폼 설정(서명 · 권한 · 번들 ID) 변경은 사용자 확인 필요"
      ]
    ]
  },
  "init_files": {
    "templates/ci.yml": ".github/workflows/ci.yml"
  }
}
